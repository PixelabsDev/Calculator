# Fastfile for Pixelabs Calculator
default_platform(:android)

platform :android do
  desc "Capture actual Compose UI screenshots on JVM via Roborazzi"
  lane :screenshots do
    sh("cd .. && ./gradlew testDebugUnitTest --tests 'com.example.PlayStoreScreenshotTest' -Proborazzi.test.record=true")
  end

  desc "Sync localized metadata and real screenshots to Google Play Console (on-demand only)"
  lane :upload_metadata_and_screenshots do |options|
    json_key = ENV["PLAY_SERVICE_ACCOUNT_JSON"] || ENV["PLAY_STORE_JSON_KEY"]
    if json_key.nil? || json_key.empty?
      UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON secret is required to upload assets to Google Play Console")
    end

    key_file = "/tmp/play-service-account.json"
    File.write(key_file, json_key)

    supply(
      package_name: "com.aistudio.calculator.gtypxz",
      json_key: key_file,
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: options[:skip_changelogs] || false,
      skip_upload_images: options[:skip_images] || false,
      skip_upload_screenshots: options[:skip_screenshots] || false,
      validate_only: options[:validate_only] || false
    )
  ensure
    File.delete(key_file) if File.exist?(key_file)
  end
end
